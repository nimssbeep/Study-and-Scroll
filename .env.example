# Gemini API Key for live AI Persona Feed & Comment Replies (leave blank or provide your key)
# Get a free API key from Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# Default Gemini Model (gemini-3-flash, gemini-3-flash-preview, gemini-2.0-flash, or gemini-1.5-flash)
VITE_GEMINI_MODEL=gemini-3-flash

# Custom Logo path inside /public folder (default: /logo.jpg)
VITE_CUSTOM_LOGO_URL=/logo.jpg

# Optional: Firebase Configuration JSON string (automatically falls back to LocalStorage if left blank)
VITE_FIREBASE_CONFIG=
